{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Fuzzy",
	"mainBinaryName": "Fuzzy",
	"version": "0.1.0",
	"identifier": "com.fuzzy.desktop",
	"build": {
		"beforeDevCommand": "bun run dev:tauri",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build:tauri",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Fuzzy セットアップ・保守",
				"width": 1080,
				"height": 760,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"publisher": "Fuzzy Project",
		"category": "Education",
		"shortDescription": "Moodleの授業資料と課題をローカルで整理する学習補助アプリ",
		"longDescription": "Fuzzyは、Moodleの授業資料を自動整理し、課題と締切をローカル環境で一元化するWindows 11向け学習補助アプリです。",
		"resources": {
			"../../extension/.output/chrome-mv3/": "resources/extension/chrome-mv3/",
			"resources/": "resources/"
		},
		"windows": {
			"allowDowngrades": false,
			"nsis": {
				"installMode": "currentUser",
				"languages": ["Japanese", "English"],
				"installerHooks": "./windows/installer-hooks.nsh"
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
